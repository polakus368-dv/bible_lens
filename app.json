{
  "expo": {
    "name": "Bible Lens",
    "slug": "bible-lens",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.biblelens.app",
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a Bible Lens seleccionar fotos con citas bíblicas.",
          "cameraPermission": "Permite a Bible Lens tomar fotos de textos con citas bíblicas.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Permite a Bible Lens escanear páginas con citas bíblicas."
        }
      ],
      "expo-sharing"
    ]
  }
}
